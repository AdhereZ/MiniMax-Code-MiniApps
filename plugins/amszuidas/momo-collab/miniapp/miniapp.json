{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/collab",
    "window": {
      "width": 1080,
      "height": 720,
      "minWidth": 720,
      "minHeight": 480
    }
  },
  "mcpEndpoints": [
    {
      "server": "momo",
      "path": "/mcp/momo"
    }
  ],
  "agentAccess": [
    "session.run"
  ],
  "agentConcurrency": 8
}
